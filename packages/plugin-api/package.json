{
  "name": "@floatboat/nexus-plugin-api",
  "version": "0.0.14",
  "description": "Browser-safe public contracts for the Nexus plugin platform.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform browser --dts --clean",
    "check:api": "pnpm build && tsc --noEmit -p tsconfig.api.json && node scripts/check-api.mjs",
    "check:api:update": "pnpm build && node scripts/check-api.mjs --write",
    "test": "vitest run --config vitest.config.ts test"
  },
  "dependencies": {
    "@floatboat/nexus-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
